# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Split-deploy: URL of the Railway-hosted Socket.io server (set on Vercel at build time).
# In local dev this can be left unset; the client falls back to NEXT_PUBLIC_APP_URL.
# Example production value: https://real-time-whiteboard.up.railway.app
NEXT_PUBLIC_SOCKET_URL=

# Split-deploy: the Vercel frontend URL, used by the Railway Socket.io server for CORS.
# Example: https://real-time-whiteboard.vercel.app
FRONTEND_URL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017/whiteboard

# Redis (required from Phase 3 onward -- powers the Socket.io adapter and shared room state)
REDIS_URL=redis://localhost:6379
